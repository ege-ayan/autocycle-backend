SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=autocycle
DATABASE_USERNAME=autocycle
DATABASE_PASSWORD=autocycle

APP_VECTOR_ENABLED=true
SIMILARITY_THRESHOLD=0.8

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=autocycle-product-images
# LocalStack only. Leave empty for real AWS.
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=

# eu-central-1 uses the EU inference profile. In us-east-1 use us.amazon.nova-pro-v1:0.
BEDROCK_MODEL=eu.amazon.nova-pro-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_IMAGE_MODEL=amazon.nova-canvas-v1:0
